{
  "name": "@dsh-external/dsh-manuscript-tracker",
  "version": "0.0.1",
  "description": "投稿状态追踪：追踪学术期刊投稿进度（已投/审稿/修改/已接受/已拒稿）并按计划汇报，已结束投稿可按时间范围追溯；Editorial Manager 期刊确定性抓取，其他投稿系统结构化识别后通用抓取",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "locale",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "BSD-3-Clause",
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build:client": "tsdown"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  }
}
